<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 o successivo: backup su cloud e trasferimento da telefono a telefono -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="app_log.txt" />
        <exclude domain="file" path="last_crash.txt" />
        <exclude domain="sharedpref" path="pending_widget.xml" />
        <exclude domain="sharedpref" path="mlauncher_perf.xml" />
        <exclude domain="sharedpref" path="mlauncher_start.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="app_log.txt" />
        <exclude domain="file" path="last_crash.txt" />
        <exclude domain="sharedpref" path="pending_widget.xml" />
        <exclude domain="sharedpref" path="mlauncher_perf.xml" />
        <exclude domain="sharedpref" path="mlauncher_start.xml" />
    </device-transfer>
</data-extraction-rules>
